# ==========================================
# Enterprise HR AI Agent Environment Configuration
# ==========================================

# LLM Provider Configuration
# Options: "groq", "openai", "mock"
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# Pinecone Vector RAG Configuration
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hr-policy-index
PINECONE_ENVIRONMENT=us-east-1

# Embedding Model Configuration
# Options: "huggingface", "openai"
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# LangSmith Observability & Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-hr-ai-agent
